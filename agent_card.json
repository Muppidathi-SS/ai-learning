{
  "agent_id": "urn:agent:devdocs:orchestrator-squad",
  "name": "SDK Migration Orchestrator Squad",
  "version": "1.0.0",
  "description": "Orchestrator coordinating Version/Deprecation and Code Sample specialists for automated developer SDK migration analysis across v1, v2, and v3 APIs.",
  "capabilities": [
    {
      "skill": "sdk_migration_orchestration",
      "description": "Decomposes migration query and coordinates specialist workers."
    },
    {
      "skill": "version_deprecation_audit",
      "description": "Audits symbol deprecations and sunset timelines."
    },
    {
      "skill": "openapi_code_synthesis",
      "description": "Synthesizes executable migration code samples grounded in OpenAPI schemas."
    }
  ],
  "interfaces": {
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Developer migration question"
        },
        "current_sdk_version": {
          "type": "string",
          "enum": ["v1", "v2"],
          "default": "v2"
        },
        "target_sdk_version": {
          "type": "string",
          "enum": ["v2", "v3"],
          "default": "v3"
        }
      },
      "required": ["query"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "v3_code": {
          "type": "string",
          "description": "Synthesized Python migration code"
        },
        "deprecated_symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_state": {
          "type": "string",
          "enum": ["SUBMITTED", "WORKING", "PAUSED: input-required", "COMPLETED", "FAILED"]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["v3_code", "task_state"]
    }
  },
  "authentication": {
    "type": "bearer_token",
    "scope": "sdk:migrate:execute",
    "issuer": "https://auth.internal.company.net/v1/tokens"
  }
}
